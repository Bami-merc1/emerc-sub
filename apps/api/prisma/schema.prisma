// EMerc Data — Prisma Schema
// Core models from Project Plan Section 7.1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  WALLET_FUNDING
  DATA_PURCHASE
  AIRTIME_PURCHASE
  AIRTIME_SELL
  WITHDRAWAL
  REFUND
  MARKETPLACE_ESCROW
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum Network {
  MTN
  AIRTEL
  GLO
  NINE_MOBILE
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String    @unique
  password      String
  role          Role      @default(USER)
  isVerified    Boolean   @default(false)
  isPhoneVerified Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  wallet        Wallet?
  transactions  Transaction[]
  dataOrders    DataOrder[]
  notifications Notification[]
  adminLogs     AdminLog[]

  marketListings MarketListing[]
  buyerOrders    MarketOrder[]    @relation("BuyerOrders")
  sellerOrders   MarketOrder[]    @relation("SellerOrders")

  bankAccounts       BankAccount[]
  withdrawalRequests WithdrawalRequest[]

  airtimeSellOrders AirtimeSellOrder[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  currency  String   @default("NGN")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      TransactionType
  amount    Decimal           @db.Decimal(12, 2)
  status    TransactionStatus @default(PENDING)
  reference String            @unique
  meta      Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model DataOrder {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  network   Network
  phone     String
  bundle    String
  amount    Decimal     @db.Decimal(12, 2)
  status    OrderStatus @default(PENDING)
  vtuRef    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model DataPlan {
  id             String   @id @default(cuid())
  network        Network
  name           String
  size           String
  validity       String
  wholesalePrice Decimal  @db.Decimal(12, 2)
  retailPrice    Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  type      String
  message   String
  isRead    Boolean             @default(false)
  channel   NotificationChannel
  createdAt DateTime            @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  target    String
  timestamp DateTime @default(now())
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

enum MarketOrderStatus {
  AWAITING_FULFILLMENT
  FULFILLED
  CONFIRMED
  DISPUTED
  REFUNDED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

model MarketListing {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id])
  assetType   String
  network     Network
  bundleSize  String
  amount      Decimal       @db.Decimal(12, 2)
  askingPrice Decimal       @db.Decimal(12, 2)
  status      ListingStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders MarketOrder[]
}

model MarketOrder {
  id                  String            @id @default(cuid())
  listingId           String
  listing             MarketListing     @relation(fields: [listingId], references: [id])
  buyerId             String
  buyer               User              @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId            String
  seller              User              @relation("SellerOrders", fields: [sellerId], references: [id])
  recipientPhone      String
  amount              Decimal           @db.Decimal(12, 2)
  status              MarketOrderStatus @default(AWAITING_FULFILLMENT)
  fulfillmentDeadline DateTime
  confirmedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  escrow EscrowLedger?
}

model EscrowLedger {
  id         String       @id @default(cuid())
  orderId    String       @unique
  order      MarketOrder  @relation(fields: [orderId], references: [id])
  amount     Decimal      @db.Decimal(12, 2)
  status     EscrowStatus @default(HELD)
  heldAt     DateTime     @default(now())
  releasedAt DateTime?
}

enum WithdrawalStatus {
  PENDING
  SUCCESS
  FAILED
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  recipientCode String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  bankAccountId String
  status        WithdrawalStatus @default(PENDING)
  reference     String           @unique
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
}


enum SellOrderStatus {
  PENDING
  RECEIVED
  COMPLETED
  EXPIRED
}

model AirtimeSellOrder {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  network        Network
  amount         Decimal         @db.Decimal(12, 2)
  cashValue      Decimal         @db.Decimal(12, 2)
  referenceCode  String          @unique
  receivingNumber String
  status         SellOrderStatus @default(PENDING)
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime        @default(now())
}